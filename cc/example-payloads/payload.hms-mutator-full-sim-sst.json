            }
        },
        {
            "name": "SeedsStore",
            "store_type": "FS",
            "params": {
                "root": "/data/seed-generator-seeds"
            }
        },
        {
            "name": "BlocksStore",
            "store_type": "FS",
            "params": {
                "root": "/data/seed-generator-blocks"
            }
        }
    ],
    "actions": [
        {
            "type": "full_simulation_sst",
            "name": "full_simulation_sst",
