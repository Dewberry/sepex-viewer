            "inputs": [
                {
                    "name": "seeds",
                    "store_name": "SeedsStore",
                    "paths": {
                        "default": "seeds.json"
                    }
                },
                {
                    "name": "blocks",
                    "store_name": "BlocksStore",
                    "paths": {
                        "default": "blocks.json"
                    }
                }
            ],
            "outputs": [
                {
                    "name": "storms",
