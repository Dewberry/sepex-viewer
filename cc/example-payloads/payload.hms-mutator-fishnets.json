{
  "attributes": {},
  "stores": [
    {
      "name": "FishnetStore",
      "store_type": "FS",
      "params": {
        "root": "/data/hms-mutator-fishnets"
      }
    },
    {
      "name": "SeedsStore",
      "store_type": "FS",
      "params": {
        "root": "/data/seed-generator-seeds"
      }
    }
  ],
  "inputs": [
    {
      "name": "HMS Model",
      "paths": {
        "grid": "catalog.grid"
      },
      "store_name": "FishnetStore"
    },
    {
      "name": "TranspositionRegion",
      "paths": {
        "default": "transposition-domain.gpkg"
      },
      "store_name": "FishnetStore"
    },
    {
      "name": "WatershedBoundary",
      "paths": {
        "default": "watershed-boundary.gpkg"
      },
      "store_name": "FishnetStore"
    },
    {
      "name": "seeds",
      "paths": {
        "default": "seeds.json"
      },
      "store_name": "SeedsStore"
    }
  ],
  "outputs": [
    {
      "name": "ValidLocations",
      "paths": {
        "default": "fishnets"
      },
      "store_name": "FishnetStore"
    }
  ],
  "actions": [
    {
      "name": "valid_stratified_locations",
      "type": "valid_stratified_locations",
      "description": "create stratified fishnets for storms",
      "attributes": {
        "_comment": "4km in meters",
        "spacing": 4000,
        "acceptance_threshold": 0.0
      }
    }
  ]
}