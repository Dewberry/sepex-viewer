# ──────────────────────────────────────────────────────────────
# Sepex Viewer — client environment variables
# Copy to .env.local for local development.
# ──────────────────────────────────────────────────────────────

# --- Sepex API
# Base URL of the Sepex Go API (OGC API – Processes server).
NEXT_PUBLIC_SEPEX_BASE_URL=http://localhost:5050

# Submitter email sent in the X-SEPEX-User-Email header on job submissions.
# Used until real auth is wired in.
NEXT_PUBLIC_SEPEX_USER_EMAIL=dev@dewberry.local
