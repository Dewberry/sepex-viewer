# ──────────────────────────────────────────────────────────────
# Sepex Viewer — client environment variables
# Copy to .env.local for local development.
# ──────────────────────────────────────────────────────────────

# --- Sepex API
# Base URL of the OGC API – Processes server this Viewer points at.
# One Viewer deployment ↔ one API server.
NEXT_PUBLIC_API_URL=http://localhost:5050

# Where the Landing page's "View API docs" button links. Per-deployment
# override — point at hosted Swagger/Redoc, GitHub README, internal wiki, etc.
# Defaults to the Sepex server's own OpenAPI UI when unset.
NEXT_PUBLIC_API_DOCS_URL=

# Submitter email sent in the X-SEPEX-User-Email header on job submissions.
# Used until real auth is wired in.
NEXT_PUBLIC_SEPEX_USER_EMAIL=dev@dewberry.local

# --- Auth (NextAuth + Keycloak; wired in Bucket 2)
# Keycloak provider config. Leave blank locally — without an issuer, NextAuth
# registers no providers and the app runs unauthenticated.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=

# Required in all envs — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Public origin of the app, used for OAuth redirects.
AUTH_URL=http://localhost:3000
